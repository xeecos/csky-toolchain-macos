# ---- 编译好的交叉工具链（build-toolchain.sh 的产物）----
# 含源码 src/、构建目录 build/、安装目录 install/ 与 build.log；体积数 GB 且可重建，不入库。
# 需重建: CSKY_ROOT=toolchain ./build-toolchain.sh
/toolchain/

# ---- 编译与打包产物 ----
test/*.elf
test/*.hex
fwpack/firmware.bin
fwpack/*.part

# ---- Python 虚拟环境（fwpack/usbboot.py 需要 pyusb）----
.venv/

# ---- macOS ----
.DS_Store

# ---- 厂商 SDK 源码树（体积大、可从官方仓库重新克隆，不入库）----
# 重新获取: git clone --depth 1 --branch TXW82x_FPV-v2.7.0.7-43482 \
#   https://github.com/Taixin-Semiconductor/TXW82x_FPV.git TXW82x_FPV
